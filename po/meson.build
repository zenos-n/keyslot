i18n = import('i18n')
i18n.gettext('keyslot', args: ['--from-code=UTF-8',
  '--keyword=fail:2', '--keyword=reject:2', '--keyword=VaultError:1',
  '--keyword=WordListError:1', '--keyword=EngineError:2', '--keyword=_tr:1', '--keyword=_trc:1c,2', '--keyword=_trf:1', '--keyword=_mark:1', '--keyword=_ntrf:1,2',
  '--flag=_trf:1:python-brace-format', '--flag=_ntrf:1:python-brace-format',
  '--flag=_ntrf:2:python-brace-format'])
