msgstr "Konfiguracja zawiera nieobsługiwany tryb generatora haseł."

#: keyslot/configuration.py:421
msgid "The configuration contains unsupported password generator settings."
msgstr "Konfiguracja zawiera nieobsługiwane ustawienia generatora haseł."

#: keyslot/configuration.py:429
msgid "Choose supported password generator settings."
msgstr "Wybierz obsługiwane ustawienia generatora haseł."

#: keyslot/core_backend.py:29
msgid "Choose an icon file smaller than 8 MiB."
msgstr "Wybierz plik ikony mniejszy niż 8 MiB."

#: keyslot/core_backend.py:48
msgid "This SVG icon could not be decoded."
msgstr "Nie można zdekodować tej ikony SVG."

