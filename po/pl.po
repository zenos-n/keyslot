msgstr "Uwierzytelnianie systemowe jest niedostępne. Użyj hasła głównego."

#: keyslot/core_backend.py:575
msgid "Choose a nonempty master password for the imported database."
msgstr "Wybierz niepuste hasło główne dla zaimportowanej bazy danych."

#: keyslot/core_backend.py:578 keyslot/core_backend.py:582
