msgid "The native engine returned an invalid request ID."
msgstr "Silnik natywny zwrócił nieprawidłowy identyfikator żądania."

#: keyslot/core_backend.py:319
msgid "The native engine timed out. Check your hardware key, then unlock again."
msgstr "Przekroczono limit czasu silnika natywnego. Sprawdź klucz sprzętowy, a następnie odblokuj ponownie."

#: keyslot/core_backend.py:331
msgid "The native operation stopped. An encrypted recovery copy remains at:\n"
msgstr "Operacja natywna została zatrzymana. Zaszyfrowana kopia odzyskiwania znajduje się w:\n"

#: keyslot/core_backend.py:337
msgid "Communication with the native engine failed. Unlock the database again."
msgstr "Komunikacja z silnikiem natywnym nie powiodła się. Odblokuj bazę danych ponownie."

