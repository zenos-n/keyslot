#: keyslot/core_backend.py:230 keyslot/core_backend.py:233
#: keyslot/core_backend.py:433
msgid "The native engine protocol is incompatible with this client."
msgstr "Protokół silnika natywnego jest niezgodny z tym klientem."

#: keyslot/core_backend.py:237
msgid "Update the native engine before disabling automatic saving."
msgstr "Zaktualizuj silnik natywny przed wyłączeniem automatycznego zapisywania."

#: keyslot/core_backend.py:261
