msgstr "Ta rejestracja przeglądarki jest zbyt duża. Jej ustawienia zostały zachowane."

#: keyslot/browser_hosts.py:86
msgid "Choose a supported browser."
msgstr "Wybierz obsługiwaną przeglądarkę."

#: keyslot/browser_hosts.py:110 keyslot/browser_hosts.py:123
#: keyslot/browser_hosts.py:133
msgid "The browser connection changed. Review it again before replacing it."
msgstr "Połączenie przeglądarki uległo zmianie. Sprawdź je ponownie przed zastąpieniem."

#: keyslot/browser_hosts.py:139
msgid "Replacing this browser's current connection requires confirmation."
msgstr "Zastąpienie bieżącego połączenia tej przeglądarki wymaga potwierdzenia."

#: keyslot/browser_hosts.py:163
msgid "Another application changed this browser connection. Its settings have been preserved."
msgstr "Inna aplikacja zmieniła to połączenie przeglądarki. Zachowano jego ustawienia."

#: keyslot/browser_requests.py:105
msgid "The browser request was cancelled."
msgstr "Anulowano żądanie przeglądarki."

#: keyslot/configuration.py:120
