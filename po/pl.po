msgstr "Silnik zwrócił nieprawidłowe informacje o polu automatycznego wpisywania."

#: keyslot/core_backend.py:726 keyslot/core_backend.py:738
msgid "Update the native engine before displaying Auto-Type search results."
msgstr "Zaktualizuj silnik natywny przed wyświetleniem wyników wyszukiwania automatycznego wpisywania."

#: keyslot/core_backend.py:732 keyslot/core_backend.py:744
#: keyslot/core_backend.py:748
msgid "The engine returned invalid Auto-Type search results."
msgstr "Silnik zwrócił nieprawidłowe wyniki wyszukiwania automatycznego wpisywania."

#: keyslot/core_backend.py:741
msgid "Choose supported Auto-Type sorting and keyboard permission settings."
msgstr "Wybierz obsługiwane ustawienia sortowania automatycznego wpisywania i uprawnień klawiatury."

#: keyslot/core_backend.py:766
msgid "Use a separate helper for KeeShare identity settings."
msgstr "Użyj osobnego pomocnika do ustawień tożsamości KeeShare."

#: keyslot/core_backend.py:771
msgid "Update the native engine before managing the KeeShare identity."
msgstr "Zaktualizuj silnik natywny przed zarządzaniem tożsamością KeeShare."

