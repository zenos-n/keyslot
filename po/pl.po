#: keyslot/core_backend.py:655
msgid "Unlock the vault before configuring SSH integration."
msgstr "Odblokuj sejf przed skonfigurowaniem integracji SSH."

#: keyslot/core_backend.py:681
msgid "Enable SSH-agent integration for this unlocked vault first."
msgstr "Najpierw włącz integrację z agentem SSH dla tego odblokowanego sejfu."

#: keyslot/core_backend.py:700 keyslot/core_backend.py:755
msgid "Update the native engine before using field-only Auto-Type actions."
msgstr "Zaktualizuj silnik natywny przed użyciem działań automatycznego wpisywania ograniczonych do pól."

#: keyslot/core_backend.py:704
