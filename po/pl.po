#: engine/main.cpp:2191
msgid "Drop at most 256 MiB at once. Larger individual files can use Add Attachment."
msgstr "Jednorazowo upuść maksymalnie 256 MiB. Większe pliki można dodać za pomocą opcji Dodaj załącznik."

#: engine/main.cpp:2196
msgid "An attachment already uses a dropped file's name. Review replacements first."
msgstr "Załącznik już używa nazwy upuszczonego pliku. Najpierw sprawdź zastępowane pliki."

#: engine/main.cpp:2200
msgid "A dropped file changed after review. Drop the files again."
msgstr "Upuszczony plik uległ zmianie po sprawdzeniu. Upuść pliki ponownie."

#: engine/main.cpp:2203
msgid "An attachment source changed or could not be opened."
msgstr "Źródło załącznika uległo zmianie lub nie można go otworzyć."

#: engine/main.cpp:2207
msgid "A dropped file changed while being read. No attachments were added."
msgstr "Upuszczony plik uległ zmianie podczas odczytu. Nie dodano żadnych załączników."

#: engine/main.cpp:2217
msgid "A dropped file changed before saving. No attachments were added."
msgstr "Upuszczony plik uległ zmianie przed zapisaniem. Nie dodano żadnych załączników."

#: engine/main.cpp:2228
msgid "Choose an attachment name."
msgstr "Wybierz nazwę załącznika."

#: engine/main.cpp:2232
msgid "Choose one attachment input source."
msgstr "Wybierz jedno źródło wejściowe załącznika."

#: engine/main.cpp:2236
msgid "The attachment source could not be opened."
msgstr "Nie można otworzyć źródła załącznika."

#: engine/main.cpp:2239
msgid "The attachment exceeds the upstream engine's size limit."
msgstr "Załącznik przekracza limit rozmiaru silnika nadrzędnego."

#: engine/main.cpp:2242
msgid "The attachment source changed or could not be read completely."
msgstr "Źródło załącznika uległo zmianie lub nie można go w całości odczytać."

#: engine/main.cpp:2246
msgid "The attachment encoding is invalid."
msgstr "Kodowanie załącznika jest nieprawidłowe."

#: engine/main.cpp:2251 keyslot/backend.py:465
msgid "An attachment with this name already exists."
msgstr "Załącznik o tej nazwie już istnieje."

#: engine/main.cpp:2259
msgid "This engine operation is unavailable."
msgstr "Ta operacja silnika jest niedostępna."

#: engine/main.cpp:2298
msgid "Expected one JSON request per line."
msgstr "Oczekiwano jednego żądania JSON w każdym wierszu."

#: engine/main.cpp:2302
msgid "The request ID is invalid."
msgstr "Identyfikator żądania jest nieprawidłowy."

#: engine/main.cpp:2304
msgid "Expected request parameters."
msgstr "Oczekiwano parametrów żądania."

#: keyslot/autotype.py:24
msgid "Enable the Keyslot GNOME companion for guarded Wayland auto-type."
msgstr "Włącz dodatek Keyslot dla GNOME, aby korzystać z chronionego automatycznego wpisywania w Wayland."

#: keyslot/autotype.py:30
msgid "Focus the destination window, then return to Keyslot and try Auto-Type again."
msgstr "Uaktywnij okno docelowe, wróć do Keyslot i ponownie spróbuj automatycznego wpisywania."

#: keyslot/autotype.py:57
msgid "Auto-type was cancelled."
msgstr "Anulowano automatyczne wpisywanie."

#: keyslot/autotype.py:94
msgid "The keyboard portal returned an unexpected request handle."
msgstr "Portal klawiatury zwrócił nieoczekiwany uchwyt żądania."

#: keyslot/autotype.py:99
msgid "Keyboard permission timed out."
msgstr "Upłynął czas oczekiwania na zgodę na użycie klawiatury."

#: keyslot/autotype.py:103
msgid "Keyboard permission was not granted."
msgstr "Nie przyznano uprawnień do klawiatury."

#: keyslot/autotype.py:148
msgid "The keyboard portal returned an invalid session."
msgstr "Portal klawiatury zwrócił nieprawidłową sesję."

#: keyslot/autotype.py:163
msgid "The portal did not grant keyboard access."
msgstr "Portal nie przyznał dostępu do klawiatury."

#: keyslot/autotype.py:247
msgid "Auto-type was cancelled or took too long."
msgstr "Automatyczne wpisywanie anulowano lub trwało zbyt długo."

#: keyslot/autotype.py:249
msgid "Auto-type stopped because the destination window changed."
msgstr "Automatyczne wpisywanie zatrzymano, ponieważ zmieniło się okno docelowe."

#: keyslot/autotype.py:259
msgid "The auto-type destination is no longer available."
msgstr "Cel automatycznego wpisywania nie jest już dostępny."

#: keyslot/autotype.py:283
msgid "The keyboard portal could not complete auto-type."
msgstr "Portal klawiatury nie może zakończyć automatycznego wpisywania."

#: keyslot/backend.py:102
msgid "Unsupported XML declarations in database export."
msgstr "Eksport bazy danych zawiera nieobsługiwane deklaracje XML."

#: keyslot/backend.py:106
msgid "KeePassXC returned an invalid database export."
msgstr "KeePassXC zwrócił nieprawidłowy eksport bazy danych."

#: keyslot/backend.py:149
msgid "The database has no root group."
msgstr "Baza danych nie ma grupy głównej."

#: keyslot/backend.py:162
msgid "This CLI backend cannot edit fields containing control characters or newlines."
msgstr "Ten backend CLI nie może edytować pól zawierających znaki sterujące lub znaki nowej linii."

#: keyslot/backend.py:170
msgid "Install KeePassXC 2.7.12 or later to provide keepassxc-cli."
msgstr "Zainstaluj KeePassXC 2.7.12 lub nowszy, aby uzyskać keepassxc-cli."

#: keyslot/backend.py:214 keyslot/backend.py:217 keyslot/backend.py:333
#: keyslot/core_backend.py:245 keyslot/core_backend.py:275
msgid "The database is locked."
msgstr "Baza danych jest zablokowana."

#: keyslot/backend.py:241
msgid "KeePassXC could not complete the operation. Check the credentials, key file, hardware key, and file permissions."
msgstr "KeePassXC nie może ukończyć operacji. Sprawdź dane uwierzytelniające, plik klucza, klucz sprzętowy i uprawnienia pliku."

#: keyslot/backend.py:244
msgid "KeePassXC timed out. Check whether your hardware key needs a touch."
msgstr "Przekroczono limit czasu KeePassXC. Sprawdź, czy klucz sprzętowy wymaga dotknięcia."

#: keyslot/backend.py:257
msgid "Select a database file."
msgstr "Wybierz plik bazy danych."

#: keyslot/backend.py:259
msgid "This CLI backend cannot unlock a password containing a newline or NUL."
msgstr "Ten backend CLI nie może odblokować hasła zawierającego znak nowej linii lub NUL."

#: keyslot/backend.py:276
msgid "The database changed while being read. Refresh to try again."
msgstr "Baza danych uległa zmianie podczas odczytu. Odśwież i spróbuj ponownie."

#: keyslot/backend.py:282
msgid "Refresh and select the entry again."
msgstr "Odśwież i wybierz wpis ponownie."

#: keyslot/backend.py:284
msgid "This entry has an ambiguous path. Use KeePassXC to rename it before editing or copying it here."
msgstr "Ścieżka tego wpisu jest niejednoznaczna. Zmień jego nazwę w KeePassXC przed edycją lub skopiowaniem go tutaj."

#: keyslot/backend.py:298
msgid "Choose a nonempty master password without newlines or NUL."
msgstr "Wybierz niepuste hasło główne bez znaków nowej linii ani NUL."

#: keyslot/backend.py:308
msgid "Choose an existing key file."
msgstr "Wybierz istniejący plik klucza."

#: keyslot/backend.py:318
msgid "This CLI backend supports at most 3000 bytes per edit."
msgstr "Ten backend CLI obsługuje maksymalnie 3000 bajtów na edycję."

#: keyslot/backend.py:337
msgid "KeePassXC closed before completing the operation."
msgstr "KeePassXC zamknął się przed ukończeniem operacji."

#: keyslot/backend.py:342
msgid "KeePassXC returned too much data."
msgstr "KeePassXC zwrócił zbyt dużo danych."

#: keyslot/backend.py:343
msgid "KeePassXC timed out. Check your hardware key."
msgstr "Przekroczono limit czasu KeePassXC. Sprawdź klucz sprzętowy."

#: keyslot/backend.py:351
msgid "Entry passwords containing newlines or NUL are not supported by this backend."
msgstr "Ten backend nie obsługuje haseł wpisów zawierających znaki nowej linii lub NUL."

#: keyslot/backend.py:359
msgid "KeePassXC did not confirm this change. The original database was not modified."
msgstr "KeePassXC nie potwierdził tej zmiany. Oryginalna baza danych nie została zmodyfikowana."

#: keyslot/backend.py:370
msgid "Another application changed this database. Refresh before saving."
msgstr "Inna aplikacja zmieniła tę bazę danych. Odśwież ją przed zapisaniem."

#: keyslot/backend.py:380
msgid "The database changed or was locked during this operation. The original was not replaced."
msgstr "Baza danych uległa zmianie lub została zablokowana podczas tej operacji. Oryginał nie został zastąpiony."

#: keyslot/backend.py:391
msgid "The database changed or was locked before saving. Refresh to continue."
msgstr "Baza danych uległa zmianie lub została zablokowana przed zapisaniem. Odśwież, aby kontynuować."

#: keyslot/backend.py:404
msgid "Choose a title without a slash."
msgstr "Wybierz tytuł bez ukośnika."

#: keyslot/backend.py:407
msgid "Choose a regular, uniquely named group."
msgstr "Wybierz zwykłą grupę o unikatowej nazwie."

#: keyslot/backend.py:412
msgid "Move entries separately from editing them."
msgstr "Przenieś wpisy osobno, niezależnie od ich edycji."

#: keyslot/backend.py:415
msgid "An entry with this title already exists in the group."
msgstr "W tej grupie istnieje już wpis o tym tytule."

#: keyslot/backend.py:421
msgid "KeePassXC's CLI cannot clear username, URL, or notes. Clear this field in KeePassXC until the native engine bridge is available."
msgstr "Interfejs CLI KeePassXC nie może wyczyścić nazwy użytkownika, adresu URL ani notatek. Wyczyść to pole w KeePassXC, dopóki nie będzie dostępny mostek silnika natywnego."

#: keyslot/backend.py:424
msgid "This CLI backend cannot preserve literal backslash-n in edited notes."
msgstr "Ten backend CLI nie może zachować dosłownego ciągu backslash-n w edytowanych notatkach."

#: keyslot/backend.py:439
msgid "Choose a group name without a slash."
msgstr "Wybierz nazwę grupy bez ukośnika."

#: keyslot/backend.py:441
msgid "Choose a regular parent group."
msgstr "Wybierz zwykłą grupę nadrzędną."

#: keyslot/backend.py:448
msgid "The recycle bin is disabled or this entry is already recycled. Permanent deletion is available in KeePassXC."
msgstr "Kosz jest wyłączony lub ten wpis już się w nim znajduje. Trwałe usuwanie jest dostępne w KeePassXC."

#: keyslot/backend.py:455
msgid "Choose a regular destination group."
msgstr "Wybierz zwykłą grupę docelową."

#: keyslot/backend.py:457
msgid "An entry with this title already exists at the destination."
msgstr "W miejscu docelowym istnieje już wpis o tym tytule."

#: keyslot/backend.py:472
msgid "Select an attachment from this entry."
msgstr "Wybierz załącznik z tego wpisu."

#: keyslot/backend.py:488
msgid "Choose a supported password length."
msgstr "Wybierz obsługiwaną długość hasła."

#: keyslot/browser_hosts.py:30
msgid "Install Keyslot's packaged browser proxy before configuring browsers."
msgstr "Zainstaluj dołączone proxy przeglądarki Keyslot przed skonfigurowaniem przeglądarek."

#: keyslot/browser_hosts.py:64
msgid "Browser setup records could not be read. Existing browser settings have been preserved."
