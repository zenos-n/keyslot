msgid "The native engine returned invalid database metadata."
msgstr "Silnik natywny zwrócił nieprawidłowe metadane bazy danych."

#: keyslot/core_backend.py:362
msgid "The entry changed. Refresh and select it again."
msgstr "Wpis uległ zmianie. Odśwież i wybierz go ponownie."

#: keyslot/core_backend.py:380
msgid "Choose a nonempty master password."
msgstr "Wybierz niepuste hasło główne."

#: keyslot/core_backend.py:418
msgid "Choose whether to save vault changes automatically."
msgstr "Wybierz, czy zmiany sejfu mają być zapisywane automatycznie."

#: keyslot/core_backend.py:438
