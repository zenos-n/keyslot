msgstr "Wybierz obsługiwany przełącznik kopii zapasowych i wzorzec ścieżki pliku."

#: keyslot/core_backend.py:463
msgid "Update the native engine before using automatic vault reload."
msgstr "Zaktualizuj silnik natywny przed użyciem automatycznego ponownego wczytywania sejfu."

#: keyslot/core_backend.py:472
msgid "Unlock the vault before configuring login unlock."
msgstr "Odblokuj sejf przed skonfigurowaniem odblokowywania przy logowaniu."

#: keyslot/core_backend.py:475
msgid "The native engine did not verify the vault credential."
msgstr "Silnik natywny nie zweryfikował danych uwierzytelniających sejfu."

#: keyslot/core_backend.py:480
msgid "Unlock the vault before configuring quick unlock."
msgstr "Odblokuj sejf przed skonfigurowaniem szybkiego odblokowywania."

#: keyslot/core_backend.py:503
msgid "Update the native engine before using system authentication."
msgstr "Zaktualizuj silnik natywny przed użyciem uwierzytelniania systemowego."

#: keyslot/core_backend.py:505
msgid "The native vault helper stopped."
msgstr "Natywny proces obsługi bazy danych został zatrzymany."

