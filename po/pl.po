#: keyslot/core_backend.py:516
msgid "Unlock this vault with its master credential first."
msgstr "Najpierw odblokuj ten sejf za pomocą hasła głównego."

#: keyslot/core_backend.py:522
msgid "The system-authentication enrollment response is invalid."
msgstr "Odpowiedź rejestracji uwierzytelniania systemowego jest nieprawidłowa."

#: keyslot/core_backend.py:527
