msgid "Build and install Keyslot's native KeePassXC engine. The CLI-only backend cannot provide the required editing compatibility."
msgstr "Zbuduj i zainstaluj natywny silnik KeePassXC Keyslot. Backend korzystający wyłącznie z CLI nie zapewnia wymaganej zgodności edycji."

#: keyslot/core_backend.py:169 keyslot/core_backend.py:171
msgid "Unsaved changes were kept in an encrypted recovery copy."
msgstr "Niezapisane zmiany zachowano w zaszyfrowanej kopii odzyskiwania."

#: keyslot/core_backend.py:213
